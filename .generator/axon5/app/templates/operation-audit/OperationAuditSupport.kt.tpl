private const val AUDIT_HTTP_STATE = "medol.audit.httpState"
class AuditHttpState {
    val started: Instant = Instant.now()
    val recorded = AtomicBoolean()
    @Volatile var actorId: String? = null
    @Volatile var tenantId: String? = null
    @Volatile var matched = false
    @Volatile var error: Throwable? = null
}

class OperationAuditHttpFilter(private val recorder: OperationAuditPublisher) : OncePerRequestFilter() {
    override fun doFilterInternal(request: HttpServletRequest, response: HttpServletResponse, chain: FilterChain) {
        val state = AuditHttpState()
        request.setAttribute(AUDIT_HTTP_STATE, state)
        val correlation = request.getHeader("X-Correlation-Id")?.take(255) ?: UUID.randomUUID().toString()
        request.setAttribute("medol.audit.correlationId", correlation)
        response.setHeader("X-Correlation-Id", correlation)
        fun record() {
            if (!state.recorded.compareAndSet(false, true)) return
            if (!state.matched && response.status < 400 && state.error == null) return
            val status = if (state.error != null && response.status < 400) 500 else response.status
            val route = request.getAttribute(HandlerMapping.BEST_MATCHING_PATTERN_ATTRIBUTE)?.toString() ?: "UNMAPPED"
            recorder.record(OperationAuditObservation(
                category = "HTTP", operation = "${request.method} $route",
                outcome = when { status >= 500 -> "FAILED"; status >= 400 -> "REJECTED"; else -> "SUCCEEDED" },
                started = state.started, actorId = state.actorId, tenantId = state.tenantId,
                correlationId = correlation, httpStatus = status,
                errorCode = if (status >= 400) "HTTP_$status" else null
            ))
        }
        try { chain.doFilter(request, response) }
        catch (error: Throwable) { state.error = error; throw error }
        finally {
            if (request.isAsyncStarted) {
                val listener = object : AsyncListener {
                    override fun onComplete(event: AsyncEvent) { record() }
                    override fun onError(event: AsyncEvent) { state.error = event.throwable }
                    override fun onTimeout(event: AsyncEvent) { state.error = java.util.concurrent.TimeoutException() }
                    override fun onStartAsync(event: AsyncEvent) { event.asyncContext.addListener(this) }
                }
                try { request.asyncContext.addListener(listener) } catch (_: IllegalStateException) { record() }
            } else record()
        }
    }
}

private fun trustedAuditActor(): String? {
    val authentication = SecurityContextHolder.getContext().authentication ?: return null
    if (!authentication.isAuthenticated || authentication is AnonymousAuthenticationToken) return null
    return (authentication.principal as? CurrentUser)?.id?.toString() ?: authentication.name
}

private fun auditCause(error: Throwable?): Throwable? {
    var current = error
    repeat(12) {
        if (current is java.util.concurrent.CompletionException || current is java.util.concurrent.ExecutionException) {
            current = current?.cause ?: return current
        } else return current
    }
    return current
}
private fun auditOutcome(error: Throwable?): String = when (auditCause(error)) {
    is IllegalArgumentException, is org.springframework.security.access.AccessDeniedException -> "REJECTED"
    else -> "FAILED"
}
private fun auditErrorCode(error: Throwable?): String = when (val cause = auditCause(error)) {
    is CommandRejectedException -> cause.code
    is org.springframework.security.access.AccessDeniedException -> "ACCESS_DENIED"
    is IllegalArgumentException -> "INVALID_ARGUMENT"
    else -> "EXECUTION_FAILED"
}
