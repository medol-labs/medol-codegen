import numbering as Numbers deploy Support
import operation-audit as Audit deploy Support
context Orders {
 slice CreateOrder {
  startsLifecycle
  command CreateOrder {
   orderId: UUID id
   orderCode: String generated by Numbers rule "order"
  }
  event OrderCreated { orderId: UUID id orderCode: String }
  state Created
 }
 slice OrderCatalog { readmodel OrderCatalog[] { orderId: UUID id orderCode: String display subscribe OrderCreated } }
 concept Order { state Created slice CreateOrder slice OrderCatalog }
}
deployment Support { includes Orders }
frontend Console { includes Numbering from Support includes Orders from Support }
