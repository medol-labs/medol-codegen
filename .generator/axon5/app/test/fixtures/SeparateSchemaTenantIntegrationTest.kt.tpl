package <%= rootPackage %>.tenancy

import org.junit.jupiter.api.Test
import org.junit.jupiter.api.BeforeEach
import org.junit.jupiter.api.Assertions.*
import org.springframework.beans.factory.annotation.Autowired
import org.springframework.boot.test.context.SpringBootTest
import org.springframework.jdbc.core.JdbcTemplate
import org.springframework.transaction.PlatformTransactionManager
import org.springframework.transaction.support.TransactionTemplate
import org.springframework.security.access.AccessDeniedException
import org.axonframework.messaging.commandhandling.gateway.CommandGateway
import <%= rootPackage %>.shared.application.tenancy.*
import <%= rootPackage %>.records.createrecord.CreateRecordCommand
import <%= rootPackage %>.records.renamerecord.RenameRecordCommand
import <%= rootPackage %>.records.recordcatalog.RecordCatalogReadModelRepository
import <%= rootPackage %>.records.recordcatalog.RecordCatalogReadModelProjector
import <%= rootPackage %>.records.events.RecordCreatedEvent
import org.axonframework.messaging.eventhandling.GenericEventMessage
import org.axonframework.messaging.core.MessageType
import <%= rootPackage %>.shared.application.metadata.AuditLogEntry
import <%= rootPackage %>.shared.application.metadata.AuditLogRepository
import java.util.UUID

@SpringBootTest(properties = [
    "spring.docker.compose.enabled=false", "spring.flyway.enabled=false",
    "spring.sql.init.mode=always", "spring.sql.init.schema-locations=classpath:tenant-test-control.sql",
    "spring.datasource.url=\${TENANT_TEST_DB_URL:jdbc:h2:mem:tenant-separate-schema;DB_CLOSE_DELAY=-1;DATABASE_TO_LOWER=TRUE}",
    "spring.datasource.driver-class-name=\${TENANT_TEST_DB_DRIVER:org.h2.Driver}",
    "spring.datasource.username=\${TENANT_TEST_DB_USER:sa}", "spring.datasource.password=\${TENANT_TEST_DB_PASSWORD:}",
    "spring.datasource.hikari.maximum-pool-size=1",
    "medol.tenancy.business-pool-size=1",
    "spring.jpa.hibernate.ddl-auto=none", "axon.axonserver.enabled=false", "axon.axonserver.event-store.enabled=false",
    "medol.axon.event-storage=inmemory", "medol.tenancy.mode=separate-schema",
    "medol.tenancy.schemas[test-tenant]=tenant_a", "medol.tenancy.schemas[test-tenant-b]=tenant_b",
    "medol.tenancy.schemas[missing]=not_provisioned"
])
class SeparateSchemaTenantIntegrationTest @Autowired constructor(
    private val gateway: CommandGateway,
    private val records: RecordCatalogReadModelRepository,
    private val jdbc: JdbcTemplate,
    private val transactions: PlatformTransactionManager,
    private val audit: AuditLogRepository,
    private val projector: RecordCatalogReadModelProjector
) {
<%- tenantFixture %>
    private fun <T> tenant(id: String, block: () -> T): T = TenantScope.withIdentity(TenantIdentity(id, "test-user"), block)

    @BeforeEach
    fun provisionTestStorage() {
        jdbc.execute("CREATE TABLE IF NOT EXISTS public.audit_log(id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, user_id VARCHAR(255), session_id VARCHAR(255), correlation_id VARCHAR(255), causation_id VARCHAR(255), trace_id VARCHAR(255), tenant_id VARCHAR(255), event_type VARCHAR(255), event_timestamp TIMESTAMP WITH TIME ZONE, payload TEXT)")
        for (schema in listOf("tenant_a", "tenant_b")) {
            jdbc.execute("CREATE SCHEMA IF NOT EXISTS " + schema)
            jdbc.execute("CREATE TABLE IF NOT EXISTS " + schema + ".medol_tenant_projection_receipt(projector VARCHAR(255) NOT NULL, event_id VARCHAR(255) NOT NULL, PRIMARY KEY(projector, event_id))")
            jdbc.execute("CREATE TABLE IF NOT EXISTS " + schema + ".records_record_catalog(record_id UUID NOT NULL, tenant_id VARCHAR(255) NOT NULL, record_name VARCHAR(255), user_id VARCHAR(255), session_id VARCHAR(255), correlation_id VARCHAR(255), causation_id VARCHAR(255), trace_id VARCHAR(255), projection_updated_at TIMESTAMP, PRIMARY KEY(record_id, tenant_id))")
        }
    }

    @Test
    fun commandsAndAsyncProjectionsRouteToIndependentSchemasWithOnePooledConnection() {
        val id = UUID.randomUUID()
        for (scope in listOf("test-tenant", "test-tenant-b")) tenant(scope) {
            gateway.send(CreateRecordCommand(id, "name-" + id)).resultMessage.toCompletableFuture().join()
        }
        tenant("test-tenant") { gateway.send(RenameRecordCommand(id, "updated-a")).resultMessage.toCompletableFuture().join() }
        val deadline = System.nanoTime() + java.time.Duration.ofSeconds(8).toNanos()
        while (System.nanoTime() < deadline) {
            val a = tenant("test-tenant") { records.findById(id)?.recordName }
            val b = tenant("test-tenant-b") { records.findById(id)?.recordName }
            if (a == "updated-a" && b == "name-" + id) {
                assertEquals("updated-a", jdbc.queryForObject("SELECT record_name FROM tenant_a.records_record_catalog WHERE record_id=?", String::class.java, id))
                assertEquals("name-" + id, jdbc.queryForObject("SELECT record_name FROM tenant_b.records_record_catalog WHERE record_id=?", String::class.java, id))
                assertEquals("public", jdbc.queryForObject("SELECT current_schema()", String::class.java))
                return
            }
            Thread.sleep(20)
        }
        fail<Unit>("Expected independent tenant schemas after asynchronous event projection.")
    }

    @Test
    fun projectionReceiptAndBusinessUpdateCommitTogetherAndRedeliveryIsIdempotent() {
        val id = UUID.randomUUID()
        val event = RecordCreatedEvent(id, "first-delivery", medolTenantScope = "test-tenant")
        val message = GenericEventMessage(MessageType(RecordCreatedEvent::class.java), event, mapOf("tenantId" to "test-tenant"))
        projector.on(event, message)
        jdbc.update("UPDATE tenant_a.records_record_catalog SET record_name='after-first-delivery' WHERE record_id=?", id)
        projector.on(event, message)
        assertEquals("after-first-delivery", tenant("test-tenant") { records.findById(id)?.recordName })
        assertEquals(1, jdbc.queryForObject("SELECT COUNT(*) FROM tenant_a.medol_tenant_projection_receipt WHERE event_id=?", Int::class.java, message.identifier()))
    }

    @Test
    fun existingTransactionCannotSwitchTenantAndControlPlaneTablesStayFixed() {
        val template = TransactionTemplate(transactions)
        tenant("test-tenant") {
            template.executeWithoutResult {
                records.findById(UUID.randomUUID())
                tenant("test-tenant-b") {
                    assertThrows(AccessDeniedException::class.java) { records.findById(UUID.randomUUID()) }
                }
                audit.saveAndFlush(AuditLogEntry().apply { eventType = "schema-control-test" })
            }
        }
        assertTrue(jdbc.queryForObject("SELECT COUNT(*) FROM public.audit_log WHERE event_type='schema-control-test'", Long::class.java)!! > 0)
        template.executeWithoutResult {
            tenant("test-tenant") {
                assertThrows(AccessDeniedException::class.java) { records.findById(UUID.randomUUID()) }
            }
        }
    }

    @Test
    fun unknownOrUnprovisionedStorageNeverFallsBackToControlSchema() {
        for (scope in listOf("unknown", "missing")) tenant(scope) {
            assertThrows(Exception::class.java) { records.findById(UUID.randomUUID()) }
        }
        assertThrows(AccessDeniedException::class.java) { records.findById(UUID.randomUUID()) }
        assertEquals("public", jdbc.queryForObject("SELECT current_schema()", String::class.java))
    }
}
